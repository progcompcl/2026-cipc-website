---
interface Props {
  variant?: "default" | "home";
}
const { variant = "default" } = Astro.props;
import { Image } from "astro:assets";
import logo from "../assets/logos-progcomp/logo.svg";
import logoSmall from "../assets/logos-progcomp/logo-small.svg";
import logoDark from "../assets/logos-progcomp/logo-dark.svg";
import logoDarkSmall from "../assets/logos-progcomp/logo-small-dark.svg";
import { MobileNav } from "./MobileNav";
import { DesktopNav } from "./DesktopNav";
import { ModeToggle } from "@/components/ModeToggle";

const headerClasses = {
  default: "bg-gray-50 dark:bg-gray-900 shadow-md",
  home: "bg-black/15 backdrop-filter backdrop-blur",
}[variant];

const currentPath = Astro.url.pathname;
const navItemsData = [
  { label: "inicio", href: "/" },
  { label: "acerca", href: "/acerca/" },
  { label: "cronograma", href: "/cronograma/" },
  { label: "patrocinadores", href: "/patrocinadores/" },
  { label: "impacto", href: "/impacto/" },
  { label: "organizadores", href: "/organizadores/" },
];

const navItems = navItemsData.map((item) => ({
  ...item,
  isActive: item.href === currentPath,
}));

const editionLinks = [
  { year: "2026", location: "Valdivia", href: "https://cipc.progcomp.cl" },
  { year: "2025", location: "Valparaíso", href: "https://cipc2025.progcomp.cl" },
  { year: "2024", location: "Concepción", href: "https://cipc2024.progcomp.cl" },
  { year: "2023", location: "Valparaíso", href: "https://cipc2023.progcomp.cl" },
  { year: "2019", location: "Valdivia", href: "https://cipc2019.progcomp.cl" },
  { year: "2018", location: "Santiago", href: "https://cipc2018.progcomp.cl" },
  { year: "2017", location: "Concepción", href: "https://cipc2017.progcomp.cl" },
  { year: "2016", location: "La Serena", href: "https://cipc2016.progcomp.cl" },
  { year: "2015", location: "Valparaíso", href: "https://cipc2015.progcomp.cl" },
];
---

<header
  class:list={[
    "fixed top-0 w-[100%] h-[var(--header-height)]",
    "flex items-center justify-between px-4 py-2",
    "border-solid z-10",
    headerClasses,
  ]}
>
  <div id="header-logo" class="flex-1 basis-0">
    <a href="/">
      <Image
        src={logo}
        height="57"
        alt="Logo CIPC"
        class="hidden lg:block dark:hidden my-2"
      />
      <Image
        src={logoSmall}
        height="57"
        alt="Logo CIPC"
        class="block lg:hidden dark:hidden my-2"
      />
      <Image
        src={logoDark}
        height="57"
        alt="Logo CIPC"
        class="hidden dark:lg:block my-2"
      />
      <Image
        src={logoDarkSmall}
        height="57"
        alt="Logo CIPC"
        class="hidden dark:block dark:lg:hidden my-2"
      />
    </a>
  </div>

  <DesktopNav client:load navItems={navItems} />

  <div
    id="header-right"
    class="flex flex-1 basis-0 justify-end items-center gap-2"
  >
    {/* Botón desplegable mediante JS para soportar móviles y táctil */}
    <div class="relative">
      <button id="editions-menu-button" class="text-sm font-medium hover:text-primary px-2 sm:px-3 py-2 rounded-md transition-colors inline-flex items-center gap-1">
        <span class="hidden sm:inline">Ediciones</span>
        <span class="sm:hidden">Ediciones</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 9l-7 7-7-7"></path></svg>
      </button>
      
      <div id="editions-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-800 rounded-md shadow-lg overflow-hidden z-50">
        <ul class="py-1">
          {editionLinks.map(({ year, location, href }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer" class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                {year} - {location}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {variant !== "home" && <ModeToggle client:visible />}

    <nav class="lg:hidden">
      <MobileNav client:load navItems={navItems} variant={variant} />
    </nav>
  </div>
</header>

<script>
  function initEditionsDropdown() {
    const button = document.getElementById('editions-menu-button');
    const dropdown = document.getElementById('editions-dropdown');

    if (button && dropdown) {
      // Abrir/cerrar al hacer clic en el botón
      button.addEventListener('click', (event) => {
        event.stopPropagation();
        dropdown.classList.toggle('hidden');
      });

      // Cerrar al hacer clic fuera del menú
      document.addEventListener('click', (event) => {
        if (!dropdown.contains(event.target as Node)) {
          dropdown.classList.add('hidden');
        }
      });
    }
  }

  // Inicializar en la carga y asegurar que funcione con Astro View Transitions (si están activas)
  initEditionsDropdown();
  document.addEventListener('astro:page-load', initEditionsDropdown);
</script>