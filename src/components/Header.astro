---
interface Props {
  variant?: "default" | "home";
}
const { variant = "default" } = Astro.props;

import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import logoSmall from "../assets/logo-small.svg";
import logoDark from "../assets/logo-dark.svg";
import logoDarkSmall from "../assets/logo-small-dark.svg";
import { MobileNav } from "./MobileNav";
import { DesktopNav } from "./DesktopNav";
import { ModeToggle } from "@/components/ModeToggle";

const headerClasses = {
  default: "bg-gray-50 dark:bg-gray-900 shadow-md",
  home: "bg-black/10 backdrop-filter backdrop-blur",
}[variant];
const currentPath = Astro.url.pathname;
const navItemsData = [
  { label: "inicio", href: "/" },
  { label: "acerca", href: "/acerca/" },
  { label: "cronograma", href: "/cronograma/" },
  { label: "patrocinadores", href: "/patrocinadores/" },
  { label: "impacto", href: "/impacto/" },
  { label: "organizadores", href: "/organizadores/" },
  { 
    label: "ediciones", 
    children: [
      { label: "CIPC 2026 (Valdivia)", href: "https://cipc.progcomp.cl" },
      { label: "CIPC 2025 (Valparaíso)", href: "https://cipc2025.progcomp.cl" },
      { label: "CIPC 2024 (Concepción)", href: "https://cipc2024.progcomp.cl" },
      { label: "CIPC 2023 (Valparaíso)", href: "https://cipc2023.progcomp.cl" },
      { label: "CIPC 2019 (Valdivia)", href: "https://cipc2019.progcomp.cl" },
      { label: "CIPC 2018 (Santiago)", href: "https://cipc2018.progcomp.cl" },
      { label: "CIPC 2017 (Concepción)", href: "https://cipc2017.progcomp.cl" },
      { label: "CIPC 2016 (La serena)", href: "https://cipc2016.progcomp.cl" },
      { label: "CIPC 2015 (Valparaíso)", href: "https://cipc2015.progcomp.cl" }
    ]
  },
];

const navItems = navItemsData.map((item) => ({
  ...item,
  isActive: item.href ? item.href === currentPath : false,
}));
---

<header
  class:list={[
    "fixed top-0 w-[100%] h-[var(--header-height)]",
    "flex items-center justify-between px-4 py-2",
    "border-solid z-10",
    headerClasses,
  ]}
>
  <div id="header-logo" class="flex-1 basis-0">
    <a href="/">
      <Image
        src={logo}
        height="57"
        alt="Logo CIPC"
        class="hidden lg:block dark:hidden my-2"
      />
      <Image
        src={logoSmall}
        height="57"
        alt="Logo CIPC"
        class="block lg:hidden dark:hidden my-2"
      />
      <Image
        src={logoDark}
        height="57"
        alt="Logo CIPC"
        class="hidden dark:lg:block my-2"
      />
      <Image
        src={logoDarkSmall}
        height="57"
        alt="Logo CIPC"
        class="hidden dark:block dark:lg:hidden my-2"
      />
    </a>
  </div>

  <DesktopNav client:load navItems={navItems} />

  <div
    id="header-right"
    class="flex flex-1 basis-0 justify-end items-center gap-2"
  >
    {variant !== "home" && <ModeToggle client:visible />}

    <nav class="lg:hidden">
      <MobileNav client:load navItems={navItems} variant={variant} />
    </nav>
  </div>
</header>
