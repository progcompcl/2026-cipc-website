---
import Header from "../components/Header.astro";
import fondoValdivia from "../assets/fondo-valdivia-vertical.png";
import logoCipc from "../assets/logos-progcomp/logo-cipc.svg";
import logoProgcompcl from "../assets/logos-progcomp/logo-progcompcl.png";
import logoUss from "../assets/logos-host/logo-uss-1.png";
import logoUach from "../assets/logos-host/logo-uach.png";
import logoTopsort from "../assets/logos-sponsors/topsort.svg";
import logoOutliersCapital from "../assets/logos-sponsors/outliers-capital.png";
import logoNeuralworks from "../assets/logos-sponsors/neuralworks.svg";
import logoNicChile from "../assets/logos-sponsors/nic-chile.png";
import logoAlicantoLabs from "../assets/logos-sponsors/alicanto-labs.png";
import logoJaneStreet from "../assets/logos-sponsors/jane-street.png";
import logoContinuumHQ from "../assets/logos-sponsors/continuum-HQ.png";
import Base from "../layouts/Base.astro";
import { Link } from "@/components/ui/link";
import { Info, Terminal } from "lucide-react";
import { Image } from "astro:assets";
---

<Base title="Inicio" bodyClasses={["dark"]}>

  <Header variant="home" />

  <main class="relative min-h-[100dvh] flex flex-col !pb-0">
    <Image
      class="absolute inset-0 h-full w-full -z-10 object-cover brightness-[0.95] object-[center_65%]"
      src={fondoValdivia}
      alt="Valdivia y su río"
      width={1920}
      quality={80}
    />

    <div
      class="flex flex-col items-center max-w-2xl mx-auto"
    >
      <div class="grid grid-cols-4 gap-1 md:gap-8 mt-6 mb-4 px-2 md:px-6 w-full">
        <div class="flex items-center justify-center">
          <Image src={logoCipc} alt="CIPC" class="object-contain" />
        </div>
        <div class="flex items-center justify-center">
          <Image src={logoProgcompcl} alt="ProgcompCL" class="mr-3 object-contain" />
        </div>
        <div class="flex items-center justify-center">
          <Image src={logoUss} alt="Universidad San Sebastián" class="object-contain" />
        </div>
        <div class="flex items-center justify-center">
          <Image src={logoUach} alt="Universidad Austral de Chile" class="object-contain" />
        </div>
      </div>

      <!-- Bloque de texto principal -->
      <div class="flex flex-col items-center w-full mb-6" style="line-height: 1;">

        <p
          class="text-logo-orange text-center"
          style="font-family: var(--font-squada); font-size: min(8vw, 3.5rem); line-height: 0.9; text-shadow: 0 1px 4px rgba(0,0,0,0.95), 0 3px 12px rgba(0,0,0,0.8);"
        >
          9° CAMPAMENTO INVERNAL DE
        </p>

        <p
          class="text-white text-center"
          style="font-family: var(--font-squada); font-size: min(16vw, 7rem); line-height: 0.8; text-shadow: 0 1px 4px rgba(0,0,0,0.95), 0 3px 12px rgba(0,0,0,0.8);"
        >
          PROGRAMACIÓN
        </p>

        <p
          class="text-white text-center"
          style="font-family: var(--font-squada); font-size: min(16vw, 7rem); line-height: 0.8; text-shadow: 0 1px 4px rgba(0,0,0,0.95), 0 3px 12px rgba(0,0,0,0.8);"
        >
          COMPETITIVA
        </p>

        <p
          class="text-logo-orange text-center"
          style="font-family: var(--font-lobster); font-size: min(8vw, 3.5rem); line-height: 0.6; margin-top: -0.08em; text-shadow: 0 1px 4px rgba(0,0,0,0.95), 0 3px 12px rgba(0,0,0,0.8);"
        >
          Valdivia 2026
        </p>

        <p
          class="text-white text-center"
          style="font-family: var(--font-squada); font-size: min(6vw, 2rem); line-height: 1.3; margin-top: 0.7em; text-shadow: 0 1px 4px rgba(0,0,0,0.95), 0 3px 12px rgba(0,0,0,0.8);"
        >
          20 al 31 de julio
        </p>
      </div>

      <!-- Botones e info inscripción -->
      <div class="flex flex-col items-center pb-8 px-2 md:px-6">
        <div class="flex flex-col md:flex-row gap-2 items-center justify-center mb-2">
          <Link
            variant="default"
            size="lg"
            className="bg-logo-orange text-white hover:bg-logo-orange/90 shadow-lg shadow-black/40"
            href="https://forms.gle/M4Uo3aVxLmtAwaSi9 "
            target="_blank"
            rel="noopener noreferrer"
          >
            <Terminal className="mr-2" /> Inscríbete aquí
          </Link>
          <Link variant="secondary" size="lg" className="shadow-lg shadow-black/40" href="/acerca/">
            <Info /> Más información
          </Link>
        </div>
        <p
          class="text-white text-center mt-2"
          style="font-size: min(3.1vw, 0.875rem); text-shadow: 0 0 8px rgba(0,0,0,1), 0 0 8px rgba(0,0,0,1), 0 1px 8px rgba(0,0,0,1), 0 2px 18px rgba(0,0,0,1), 0 4px 32px rgba(0,0,0,1), 0 6px 48px rgba(0,0,0,1);"
        >
          Primer llamado cerrado! Tenemos 116 inscritos!

        </p>
        <p
          class="text-white text-center"
          style="font-size: min(3.1vw, 0.875rem); text-shadow: 0 0 8px rgba(0,0,0,1), 0 0 8px rgba(0,0,0,1), 0 1px 8px rgba(0,0,0,1), 0 2px 18px rgba(0,0,0,1), 0 4px 32px rgba(0,0,0,1), 0 6px 48px rgba(0,0,0,1);"
        >
          Segundo llamado de inscripciones abierto hasta el 5 de Julio
        </p>
      </div>
    </div>

    <div class="mt-auto w-full bg-[#99a3b0]/80 backdrop-blur-sm border-t border-white/20 pb-2 sm:pb-3 pt-2 px-3 sm:px-6 md:px-7 lg:px-10">
      <div class="mx-auto w-fit max-w-full flex flex-col gap-1 items-center">
        <p class="text-gray-700 text-[10px] uppercase tracking-widest text-center leading-none">
          Con el apoyo de
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-y-1 gap-x-3 sm:gap-x-6 md:gap-x-7 lg:gap-x-10">
          <!-- Oro -->
          <div class="flex items-center justify-center px-[15vw] sm:px-0 gap-x-8 sm:gap-x-6 md:gap-x-7 lg:gap-x-10">
            <a href="/patrocinadores/" class="flex items-center min-w-0 shrink" aria-label="Topsort">
              <Image
                src={logoTopsort}
                alt="Topsort"
                width={400}
                class="h-10 sm:h-8 md:h-9 w-auto max-w-full object-contain sm:py-1"
              />
            </a>
            <a href="/patrocinadores/" class="flex items-center min-w-0 shrink" aria-label="Outliers Capital">
              <Image
                src={logoOutliersCapital}
                alt="Outliers Capital"
                width={400}
                class="h-10 sm:h-8 md:h-9 w-auto max-w-full object-contain sm:py-1"
              />
            </a>
          </div>
          <!-- Plata -->
          <div class="flex items-center justify-center gap-x-3 sm:gap-x-6 md:gap-x-7 lg:gap-x-10">
            <a href="/patrocinadores/" class="flex items-center min-w-0 shrink" aria-label="Alincanto Labs">
              <Image
                src={logoAlicantoLabs}
                alt="AlicantoLabs"
                width={300}
                class="h-10 sm:h-8 md:h-9 w-auto max-w-full object-contain"
              />
            </a>
            <a href="/patrocinadores/" class="flex items-center min-w-0 shrink" aria-label="NeuralWorks">
              <Image
                src={logoNeuralworks}
                alt="NeuralWorks"
                width={300}
                class="h-10 sm:h-8 md:h-9 w-auto max-w-full object-contain py-[0.75rem] sm:py-[0.625rem]"
              />
            </a>
            <a href="/patrocinadores/" class="flex items-center min-w-0 shrink" aria-label="NIC Chile">
              <Image
                src={logoNicChile}
                alt="NIC Chile"
                width={300}
                class="h-10 sm:h-8 md:h-9 w-auto max-w-full object-contain"
              />
            </a>
          </div>
          <!-- Bronce (más chico que el oro) -->
          <div class="flex items-center justify-center px-[22vw] sm:px-0 gap-x-8 sm:gap-x-6 md:gap-x-7 lg:gap-x-10">
            <a href="/patrocinadores/" class="flex items-center min-w-0 shrink" aria-label="Jane Street">
              <Image
                src={logoJaneStreet}
                alt="Jane Street"
                width={300}
                class="h-8 sm:h-8 md:h-9 w-auto max-w-full object-contain"
              />
            </a>
            <a href="/patrocinadores/" class="flex items-center min-w-0 shrink" aria-label="Continuum HQ">
              <Image
                src={logoContinuumHQ}
                alt="Continuum HQ"
                width={300}
                class="h-8 sm:h-8 md:h-9 w-auto max-w-full object-contain py-[0.5rem]"
              />
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Base>
